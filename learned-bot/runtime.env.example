# 파일을 runtime.env로 복사한 뒤 환경별 절대 경로를 입력합니다.
# 이미지에는 검증한 @sha256 digest를 지정합니다. latest를 사용하지 않습니다.
LEARNED_BOT_IMAGE=
LEARNED_BOT_NETWORK=dev-model-bot
LEARNED_BOT_MODELS=/srv/arcane/dev/models/release-001
LEARNED_BOT_TOKEN_FILE=/srv/arcane/dev/secrets/bot.token
LEARNED_BOT_CPUS=1.0
LEARNED_BOT_MEMORY=768m
