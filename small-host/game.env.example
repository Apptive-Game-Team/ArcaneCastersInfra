# Copy to small-host/game.env on the host and fill in. Never commit the filled
# copy. PORT, MANAGEMENT_PORT, EXTERNAL_PORT and INTERNAL_BASE_URL come from
# docker-compose.yml.

PROTOCOL=wss
# Hostname clients reach this host by, e.g. us-central.theevilent.com.
DOMAIN=

DATABASE_URL=jdbc:postgresql://<host>:5432/<database>
DATABASE_USER=
DATABASE_PW=

ACCOUNT_SERVER_URL=
LOBBY_BASE_URL=
# Service token the game server presents to the lobby, mounted from ./keys.
# JWT_FILE_PATH=/keys/service-token

DISCORD_WEBHOOK_URL=

# Keep sessions low on a 1 GB host.
MAX_SESSIONS=10
BOT_AUTO_MATCH_ENABLED=false
