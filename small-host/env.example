# Copy to small-host/.env on the host. Never commit the filled copy.

# production: ac-game and :latest. dev: dev-game and :dev.
GAME_NAME=ac-game
GAME_IMAGE=ghcr.io/apptive-game-team/ac-game:latest

# JWT carrying the WORDONLINE_CICD authority, used to call the drain endpoint.
CICD_TOKEN=

# Seconds to wait for matches to end before the old server is stopped.
DRAIN_TIMEOUT=3600

# Optional deploy notifications.
DEPLOY_DISCORD_WEBHOOK_URL=
