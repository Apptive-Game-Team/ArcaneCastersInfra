# Compose-level variables for the deployers.
# Copy to game/.env on the host and fill in. Never commit the filled copy.

# Image tags. Overriding these pins a deploy to a specific build.
AC_GAME_IMAGE=ghcr.io/apptive-game-team/ac-game:latest
DEV_GAME_IMAGE=ghcr.io/apptive-game-team/ac-game:dev
DEPLOYER_IMAGE=ghcr.io/apptive-game-team/ac-deployer:latest

# JWTs carrying the WORDONLINE_CICD authority. One per environment — the dev
# token is issued by the dev account server and is not valid in production.
AC_CICD_TOKEN=
DEV_CICD_TOKEN=

# Optional. Deploy notifications, usually two different channels.
AC_DISCORD_WEBHOOK_URL=
DEV_DISCORD_WEBHOOK_URL=
